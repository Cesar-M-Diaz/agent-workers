{
  "name": "agent-workers",
  "version": "0.4.0",
  "private": true,
  "description": "Claude Code plugin and marketplace for running DeepSeek Harness (dsh) or pi headless workers in parallel",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-workers": "./dist/server.js",
    "agent-workers-ui": "./dist/ui.js"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "commands",
    "dist",
    "hooks",
    "legacy",
    "plugin-dist",
    "scripts",
    "skills",
    "types"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cesar-M-Diaz/agent-workers.git"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check",
    "typecheck": "tsc -b",
    "start": "node dist/server.js",
    "ui": "node dist/ui.js",
    "test": "tsc -b && node scripts/copy-assets.mjs && vitest run --exclude 'tests/**'",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

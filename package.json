{
  "name": "dsh-workers",
  "version": "0.3.1",
  "private": true,
  "description": "Standalone MCP server, live dashboard, and Claude Code commands for running DeepSeek Harness (dsh) headless workers in parallel",
  "type": "module",
  "bin": {
    "dsh-workers": "./dist/server.js",
    "dsh-workers-ui": "./dist/ui.js"
  },
  "files": [
    "dist",
    "skill",
    "claude",
    "scripts"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cesar-M-Diaz/dsh-workers.git"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b",
    "start": "node dist/server.js",
    "ui": "node dist/ui.js",
    "test": "tsc -b && node scripts/copy-assets.mjs && vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "install:claude-commands": "bash scripts/install-claude-commands.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
